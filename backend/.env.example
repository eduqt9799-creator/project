# Server
NODE_ENV=development
PORT=5000

# Allowed frontend origin(s), comma separated
CLIENT_URL=http://localhost:5173

# JWT signing secret (minimum 24 characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Google Apps Script web app deployment URL (exec endpoint)
APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbwiSJFmqxojMFFjaKqEDgjAQt9DI4xNB1BtW0W8evg5RgRMUBzmES9PB_8iOjBL8g/exec

# Optional shared key checked by the Apps Script bridge
APPS_SCRIPT_API_KEY=

# Attendance submission cutoff (IST). Default 17 => 5:00 PM IST
ATTENDANCE_CUTOFF_HOUR=17
ATTENDANCE_TIMEZONE=Asia/Kolkata

# Apps Script HTTP timeout (ms)
APPS_SCRIPT_TIMEOUT_MS=25000

# bcrypt cost factor
BCRYPT_ROUNDS=10
APPS_SCRIPT_PROTOCOL=auto
APPS_SCRIPT_ALLOW_LEGACY_PLAINTEXT=true
